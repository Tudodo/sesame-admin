# ── Database ──
DB_USER=postgres
DB_PASSWORD=your-password
DB_NAME=sesame_community
DATABASE_URL=postgres://postgres:your-password@127.0.0.1:5432/sesame_community

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-base64-string

# ── Logging ──
# Options: trace, debug, info, warn, error
RUST_LOG=info

# ── Server ──
# Default port 5150 — set SERVER_PORT to override
SERVER_PORT=5150
SERVER_BINDING=0.0.0.0

# ── Upload ──
UPLOAD_DIR=uploads

# ── Storage Secret Encryption ──
# Required when saving a new S3 secret key; used to derive the AES-256 key.
# Rotating this value invalidates previously encrypted secrets.
STORAGE_SECRET_MASTER_KEY=change-me-in-production
